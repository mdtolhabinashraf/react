{
  "name": "@tolha/react",
  "version": "1.3.2",
  "description": "Type-safe React utilities for modern TypeScript applications.",
  "license": "MIT",
  "author": "Md. Tolha Bin Ashraf",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdtolhabinashraf/react.git"
  },
  "homepage": "https://github.com/mdtolhabinashraf/react#readme",
  "bugs": {
    "url": "https://github.com/mdtolhabinashraf/react/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/API.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "react",
    "typescript",
    "react-utilities",
    "type-safe",
    "utility-library"
  ],
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "apexa": "^2.0.0",
    "zod": "^4.6.7"
  }
}
